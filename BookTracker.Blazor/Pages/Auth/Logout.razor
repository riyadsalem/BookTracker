@page "/logout"
@using global::BookTracker.Blazor.Auth
@inject BookTrackerAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Uitloggen</PageTitle>

<p>Bezig met uitloggen...</p>

@code {
    protected override async Task OnInitializedAsync()
    {
        await AuthenticationStateProvider.SignOutAsync();
        NavigationManager.NavigateTo("/booktracker");
    }
}